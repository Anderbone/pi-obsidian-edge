{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "ES2020",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "main.ts",
    "shared/**/*.ts",
    "bridge/**/*.mts",
    "tests/**/*.ts",
    "dev/preview.mts"
  ]
}
