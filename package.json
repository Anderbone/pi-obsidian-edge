{
  "name": "pi-obsidian-edge",
  "version": "0.2.4",
  "private": true,
  "description": "An original mobile-first Obsidian client and paired bridge for the Pi coding agent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "build:bridge": "npm run typecheck && node dev/build-bridge.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:bridge-package": "node dev/test-bridge-package.cjs",
    "bridge": "node --import tsx bridge/cli.ts",
    "preview": "node dev/preview.cjs",
    "lint": "eslint main.ts src bridge shared tests dev/preview.ts --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Anderbone/pi-obsidian-edge.git"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
